# API Configuration

# Production: Full URL to pytrace API server
# Used when building for production deployment
# Default: http://localhost:5000 (development only)
# VITE_API_URL=https://api.example.com:5000

# Development: Target URL for Vite dev server proxy
# Only used during 'npm run dev'
# Default: http://localhost:5000
# VITE_API_TARGET=http://localhost:5000

# Example 1: Local development (default, no need to set)
# npm run dev
# → Proxies /api/* to http://localhost:5000

# Example 2: Development against remote server
# VITE_API_TARGET=https://staging-api.example.com npm run dev
# → Proxies /api/* to https://staging-api.example.com

# Example 3: Production build for remote server
# export VITE_API_URL=https://api.example.com:5000
# npm run build
# → Built app calls https://api.example.com:5000/api/*
